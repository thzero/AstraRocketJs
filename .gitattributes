# One line ending in the repository, everywhere: LF.
#
# Without this, a Windows checkout with core.autocrlf=true has CRLF in the
# working tree while prettier's default endOfLine is "lf" — so `prettier
# --check` fails on every tracked text file for a reason that has nothing to do
# with formatting, and the format gate can never be turned on. Normalising here
# makes the two agree and keeps diffs free of whole-file line-ending churn.
* text=auto eol=lf

# Binaries: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
# .ork is normally a zip, but the e2e fixtures are plain uncompressed XML.
# `binary` froze the index at LF while the worktree held CRLF — `git status`
# only read clean because the stat cache was stale after the attribute change,
# and the next `add` would have committed an 8 KB whole-file diff that
# `git diff` refuses to display (binary implies -diff).
*.ork -text -diff
*.wasm binary
*.jar binary
*.class binary

# Windows-only scripts genuinely need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
