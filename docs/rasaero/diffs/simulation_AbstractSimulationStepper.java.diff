+	/**
+	 * PATCH (see engine-java/patches/LEDGER.md): record which stages' motors are
+	 * currently producing thrust, so the aerodynamic base-drag model can apply
+	 * the RASAero power-on base-drag reduction (motor exhaust pressurizes the
+	 * base during burn). An empty set means fully power-off (coast). Mirrors the
+	 * active-motor / thrust loop used by RK4SimulationStepper.calculateThrust.
+	 */
+	private void applyThrustState(SimulationStatus status, FlightConditions conditions) {
+		if (conditions == null) {
+			return;
+		}
+		java.util.Set<Integer> thrusting = new java.util.HashSet<>();
+		for (MotorClusterState m : status.getActiveMotors()) {
+			if (m.getThrust(status.getSimulationTime()) > 0.0) {
+				thrusting.add(((info.openrocket.core.rocketcomponent.RocketComponent)
+						m.getMount()).getStageNumber());
+			}
+		}
+		conditions.setThrustingStages(thrusting);
 	}
 
