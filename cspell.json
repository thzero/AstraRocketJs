{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaries": [
    "typescript",
    "node",
    "html",
    "css",
    "softwareTerms",
    "filetypes",
    "npm",
    "project-words"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": false
    }
  ],
  "files": [
    "web/src/**/*.{ts,tsx}",
    "web/e2e/**/*.ts",
    "web/scripts/**/*.mjs",
    "*.md",
    "docs/**/*.md",
    "website/docs/**/*.md",
    "web/src/i18n/locales/en.json"
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "engine-java/**",
    "web/public/**",
    "website/i18n/**",
    "**/*.generated.json",
    "package-lock.json",
    "**/tsconfig*.json",
    ".cspell/**",
    "LICENSE"
  ],
