# Gradle (engine-java)
engine-java/.gradle/
engine-java/build/
!engine-java/gradle/wrapper/gradle-wrapper.jar

# Node / Vite (web)
web/node_modules/
web/dist/
*.local

# Docusaurus (website) — build output, caches and generated locale files
website/node_modules/
website/build/
website/.docusaurus/
# Docs built into the app for precaching (see deploy-pages.yml)
web/public/docs/

# Playwright (web e2e) — test output + downloaded browsers, never the specs/config
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# NOTE: web/src/engine/vendor/orkengine.mjs IS committed — it's the built engine
# artifact so the web app builds without a JDK (regenerate via engine-java).

# NOTE: web/public/engine/openrocket-engine.wasm (+ its .wasm-runtime.js) ARE
# committed — the WASM-GC engine is the default backend (JS falls back), so a
# fresh checkout ships it without a JDK. Regenerate via
# `node engine-java/build-engine.mjs --wasm`.

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Unanchored: `npx` at the repo root creates a bare node_modules/ (there is no
# root package.json), and vitest rewrites node_modules/.vite/**/results.json on
# every local run — three build artifacts were tracked because only the web/ and
# website/ paths were listed, so the tree went dirty after every `npm test`.
node_modules/
test-results/
web/coverage/

# Pinned OpenRocket checkout that `extract --check` fetches for itself
# (sparse + blobless; keyed to the ref in engine-java/extract/UPSTREAM).
engine-java/.openrocket-src/
