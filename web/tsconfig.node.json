{
  // The build's own config files: vite.config.ts, vitest.config.ts,
  // playwright.config.ts and eslint.config.js decide what ships (PWA workbox
  // globs, __APP_VERSION__, worker format, base path, shard and worker counts).
  //
  // `npm run typecheck` runs three projects: `tsconfig.json` (src and tests),
  // `tsconfig.e2e.json` (the Playwright specs) and this one. A file in none of
  // them is typechecked by nothing. `allowJs` and `checkJs` are what bring
  // eslint.config.js in; without them tsc drops a .js include without a warning.
  // ESLint lints these files too, but with no type-aware rules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"]
}
