  "repository": {
    "type": "git",
    "url": "git+https://github.com/thzero/AstraRocketJs.git"
  },
  "bugs": {
    "url": "https://github.com/thzero/AstraRocketJs/issues"
  },
  "wiki": {
    "url": "https://github.com/thzero/AstraRocketJs/wiki"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && eslint . --max-warnings 0 && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:inc": "library-cli --updateversion --pi --silent && node ../scripts/stamp-wiki-version.mjs --silent",
    "stamp:wiki": "node ../scripts/stamp-wiki-version.mjs",
    "sync:contributors": "node scripts/sync-contributors.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "mustache": "^4.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "^17.0.13",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@thzero/library_cli": "^0.18.45",
    "@types/mustache": "^4.2.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
