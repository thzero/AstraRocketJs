{
  "name": "astrarocketjs-web",
  "version": "0.0.20",
  "version_major": 0,
  "version_minor": 0,
  "version_patch": 20,
  "version_date": "09/19/2026",
  "type": "module",
  "description": "AstraRocketJs — browser UI for the OpenRocket engine",
  "author": "thZero.com",
  "author_url": "https://www.thzero.com",
  "copyright": "2026",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thzero/AstraRocketJs.git"
  },
  "bugs": {
    "url": "https://github.com/thzero/AstraRocketJs/issues"
  },
  "wiki": {
    "url": "https://thzero.github.io/AstraRocketJs/docs/"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "spell": "cspell --no-progress --config ../cspell.json",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && eslint . --max-warnings 0 && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:inc": "library-cli --updateversion --pi --silent && prettier --write --log-level warn package.json",
    "gen:icons": "node scripts/gen-icons.mjs",
    "sync:motors": "node scripts/sync-motors.mjs",
    "sync:components": "node scripts/sync-components.mjs",
    "sync:contributors": "node scripts/sync-contributors.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "mustache": "^4.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "^17.0.13",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@thzero/library_cli": "^0.18.45",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cspell": "10.3.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
