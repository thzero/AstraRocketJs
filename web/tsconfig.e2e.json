{
  // The Playwright specs. The main project includes `src` and `tests` only, so
  // without this project a `noUncheckedIndexedAccess` error in a spec is caught
  // by no gate and throws the moment a selector misses.
  //
  // `@types/node` is here because a spec that reads a downloaded file off disk
  // (image-export.spec.ts) needs it.
  //
  // DOM stays in `lib` because code inside `page.evaluate()` runs in the
  // browser; Playwright types those callbacks itself.
  //
  // The ambient declarations are what `src/engine/openRocketEngine.ts` and
  // `src/services/storage/storageKeys.ts` need to typecheck; a spec keyed on
  // the engine's `ComponentType` reaches the one, `e2e/base.ts` the other.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["e2e", "src/vite-env.d.ts", "src/engine/openrocket-engine.d.ts", "src/globals.d.ts"]
}
