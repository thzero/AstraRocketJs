  "about": {
    "open": "About",
    "tagline": "A lightweight web UI for the OpenRocket engine",
    "body": "{{name}} is a fast, mobile-friendly app for designing and simulating model rockets. It runs the real OpenRocket physics engine — compiled to JavaScript — entirely in your browser, so there's nothing to install and nothing leaves your device.",
    "ork": "Full OpenRocket (.ork) support: open, edit, and save your designs round-trip.",
    "scope": "It's not a full re-creation of OpenRocket's desktop app — it's a streamlined interface over the same trusted simulation core, focused on the essentials: live CG / CP / stability, 2D & 3D views, and flight simulation.",
    "credits": "Physics by OpenRocket (GPL-3.0-or-later), compiled to JavaScript with TeaVM.",
    "privacy": "Privacy",
    "close": "Close"
  },
  "privacy": {
    "title": "Privacy Policy",
    "intro": "{{name}} runs entirely in your browser. There are no accounts, no tracking, no analytics, and no ads.",
    "storage": "Your designs, simulations, preferences, and any custom materials or motors are saved in your browser's local storage, on your device — never sent to us or anyone else. Clearing your browser data (or using New) removes them.",
    "network": "When you pick a motor, the app may fetch that motor's thrust-curve data from a public motor database and cache it locally; that request is subject to that provider's terms. Otherwise the app makes no network calls with your data.",
    "hosting": "Whoever hosts the app may keep standard web-server access logs (such as IP address and timestamp), as any website does. The app itself collects nothing.",
    "close": "Close"
  },
